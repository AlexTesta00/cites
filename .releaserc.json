{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "perf", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "revert", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Novità", "effect": "bump" },
            { "type": "fix", "section": "Correzioni", "effect": "bump" },
            { "type": "perf", "section": "Prestazioni", "effect": "bump" },
            { "type": "revert", "section": "Annullamenti", "effect": "bump" },
            { "type": "refactor", "section": "Riorganizzazione del codice", "effect": "changelog" },
            { "type": "docs", "section": "Documentazione", "effect": "hidden" },
            { "type": "style", "section": "Stile del codice", "effect": "hidden" },
            { "type": "test", "section": "Test", "effect": "hidden" },
            { "type": "build", "section": "Build", "effect": "hidden" },
            { "type": "ci", "section": "Integrazione continua", "effect": "hidden" },
            { "type": "chore", "section": "Manutenzione", "effect": "hidden" }
          ]
        }
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failTitle": false
      }
    ]
  ]
}
