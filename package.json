{
  "name": "cites",
  "version": "0.0.0-development",
  "private": true,
  "description": "Generatore gratuito di citazioni in stile pagina di libro, per storie e post Instagram.",
  "keywords": [
    "quotes",
    "citazioni",
    "instagram",
    "book",
    "highlighter",
    "canvas"
  ],
  "homepage": "https://cites.alextesta.space",
  "bugs": {
    "url": "https://github.com/AlexTesta00/cites/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexTesta00/cites.git"
  },
  "license": "Apache-2.0",
  "author": "Alex Testa (https://alextesta.space)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:assets && npm run build:css",
    "build:assets": "node scripts/copy-assets.mjs",
    "build:css": "tailwindcss -i src/css/app.css -o public/assets/css/app.css --minify",
    "watch:css": "tailwindcss -i src/css/app.css -o public/assets/css/app.css --watch",
    "serve": "php -S 127.0.0.1:8080 -t public dev/router.php",
    "lint": "eslint .",
    "test": "node --test \"tests/js/*.test.js\" && php tests/php/run.php",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/la-belle-aurore": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/nothing-you-could-do": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "gsap": "^3.15.1",
    "husky": "^9.1.7",
    "lenis": "^1.3.27",
    "semantic-release": "^26.0.1",
    "tailwindcss": "^4.3.5"
  }
}
